# ── LLM (판단 AI) ─────────────────────────────────────────
# auto: CODY_* 키가 있으면 코디세이 게이트웨이(cody), OPENAI_BASE_URL 이 있으면 openai 호환, 둘 다 없으면 rule(키워드 규칙)
LLM_PROVIDER=auto

# 코디세이 게이트웨이 (팀원 model/.env 와 같은 이름). claude* 모델은 CODY_CLAUDE_KEY, 그 밖(gpt-*)은 CODY_GPT_KEY
CODY_BASE_URL=
CODY_CLAUDE_KEY=
CODY_GPT_KEY=
# 비우면 claude-haiku-4 (팀원 llm_classify.py 기본값). 예: gpt-5.4
CODY_MODEL=
# 판단 대기 초. 넘으면 규칙 판단으로 (부모님이 경고를 오래 기다리지 않게)
LLM_TIMEOUT=20
# LLM 하루 호출 상한 (서버·스크립트 합산). 넘으면 규칙 판단. 0 = 상한 없음
LLM_DAILY_LIMIT=200

# OpenAI 호환 API (해커톤 제공 LLM, GPU 서버의 vLLM 등)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── 통화 녹음 → 텍스트 ─────────────────────────────────────
# auto: WHISPER_API_URL(GPU 서버) → (faster-whisper 설치 시) whisper_local. 팀원과 같은 faster-whisper, 서버는 large
# auto | whisper_api | whisper_local. 통화 원본은 외부 API 로 보내지 않는다
TRANSCRIBE_PROVIDER=auto
# GPU 서버에 Whisper 서버(deploy/whisper_server.py)를 띄웠을 때 (예: http://10.0.0.5:8100)
WHISPER_API_URL=
WHISPER_MODEL=large-v3
# 화자 구분 (Whisper 를 쓸 때만): 받아쓰기에 '상대:' / '부모님:' 줄 이름 → 지시를 상대 말에서만 뽑음 (ai/diarize.py)
# pyannote.audio 설치 + Hugging Face 토큰 (pyannote/speaker-diarization-3.1 약관 동의) 필요. 실패하면 줄 이름 없이
WHISPER_DIARIZE=0
HF_TOKEN=

# ── AI 서버 (ai/server.py, docs/AI_API.md) ─────────────────
# BE ↔ AI 서버 공유 키. 정하면 요청마다 X-AI-Key 헤더 필요
AI_SERVER_KEY=
AI_MAX_AUDIO_MB=25

# ── 팀원이 학습한 BERT (스미싱/스팸). 판단 경로에 들어간다 (docs/AI_API.md 판단 순서) ──
# 서버의 팀원 모델 폴더: ~/nahyun/model/out/best (klue/bert-base). large 를 올리면 out/best_large 로 바꾸기만 하면 된다
CLASSIFIER_DIR=
# LLM 이 없을 때 규칙이 '안전'이면 이 점수 이상을 사기(주의)로
CLASSIFIER_THRESHOLD=0.5
# LLM·규칙이 '안전'·'안내'라 해도 이 점수 이상이면 사기(주의)로
CLASSIFIER_STRONG=0.9
